modules = ["nodejs-24"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[deployment]
deploymentTarget = "static"
build = ["node", "scripts/build-public.mjs"]
publicDir = "generated-artifacts/public"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Public GitMesh preview"

[[workflows.workflow]]
name = "Public GitMesh preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 node projects/live/live.mjs"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
