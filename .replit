modules = ["nodejs-24"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
publicDir = "generated-artifacts/public"
run = ["npm", "start"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Public GitMesh preview"

[[workflows.workflow]]
name = "Public GitMesh preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 node projects/live/live.mjs"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 24678
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
GITMESH_ADMIN_GITHUB_ID = "332565808"
GITMESH_ADMIN_GITHUB_LOGIN = "vitalitychems-dot"
