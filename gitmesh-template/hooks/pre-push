#!/bin/sh
set -eu

HOOK_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
unset GITHUB_TOKEN

set +e
PUSH_SCAN_ENABLED=$(git config --bool --get gitmesh.prePushCredentialCheck 2>/dev/null)
CONFIG_STATUS=$?
set -e
case "$CONFIG_STATUS" in
  1)
    exit 0
    ;;
  0)
    ;;
  *)
    printf '%s\n' "GitMesh pre-push credential check could not read gitmesh.prePushCredentialCheck. Set it to true or false, then retry the push. No GitHub requests were made." >&2
    exit 1
    ;;
esac

case "$PUSH_SCAN_ENABLED" in
  true)
    ;;
  false)
    exit 0
    ;;
  *)
    printf '%s\n' "GitMesh pre-push credential check could not verify gitmesh.prePushCredentialCheck. Set it to true or false, then retry the push. No GitHub requests were made." >&2
    exit 1
    ;;
esac

if ! command -v node >/dev/null 2>&1; then
  printf '%s\n' "GitMesh pre-push credential check could not start: Node.js 20 or newer is required. Install Node.js or make node available on PATH, then retry the push. No GitHub requests were made." >&2
  exit 1
fi

NODE_VERSION=$(node --version 2>/dev/null) || NODE_VERSION=
case "$NODE_VERSION" in
  v[0-9]*.[0-9]*.[0-9]*)
    NODE_VERSION=${NODE_VERSION#v}
    NODE_MAJOR=${NODE_VERSION%%.*}
    NODE_MINOR_AND_PATCH=${NODE_VERSION#*.}
    NODE_MINOR=${NODE_MINOR_AND_PATCH%%.*}
    NODE_PATCH=${NODE_MINOR_AND_PATCH#*.}
    ;;
  *)
    printf '%s\n' "GitMesh pre-push credential check could not verify the Node.js version. Node.js 20 or newer is required. Install or upgrade Node.js to 20 or newer, ensure node --version reports v20 or newer, then retry the push. No GitHub requests were made." >&2
    exit 1
    ;;
esac

for NODE_COMPONENT in "$NODE_MAJOR" "$NODE_MINOR" "$NODE_PATCH"; do
  case "$NODE_COMPONENT" in
    ''|*[!0-9]*)
      printf '%s\n' "GitMesh pre-push credential check could not verify the Node.js version. Node.js 20 or newer is required. Install or upgrade Node.js to 20 or newer, ensure node --version reports v20 or newer, then retry the push. No GitHub requests were made." >&2
      exit 1
      ;;
  esac
done

case "$NODE_MAJOR" in
  0|[1-9]|1[0-9])
    printf '%s\n' "GitMesh pre-push credential check is blocked: detected Node.js major version $NODE_MAJOR, but Node.js 20 or newer is required. Upgrade Node.js to 20 or newer, ensure node --version reports v20 or newer, then retry the push. No GitHub requests were made." >&2
    exit 1
    ;;
  2[0-9]|[3-9][0-9]|[1-9][0-9][0-9]*)
    ;;
  *)
    printf '%s\n' "GitMesh pre-push credential check could not verify the Node.js version. Node.js 20 or newer is required. Install or upgrade Node.js to 20 or newer, ensure node --version reports v20 or newer, then retry the push. No GitHub requests were made." >&2
    exit 1
    ;;
esac

exec node "$HOOK_DIR/../sync-public-source.mjs" --check-push-credentials
